# Salin menjadi .env lalu isi. File .env jangan di-commit (sudah ada di .gitignore).
# Semua nilai di sini hanya ada di server. Browser hanya tahu URL server ini.

PORT=8787
# NODE_ENV=production   -> server menolak menyala bila AI_AUTH_SECRET / ALLOWED_ORIGINS belum diisi

# ---------- AI ----------
#   pollinations -> gratis tanpa daftar & tanpa kunci (batas 1 jawaban / 45 detik per IP)
#   gemini       -> Google AI Studio, tier gratis. Kunci: https://aistudio.google.com/apikey
#   groq         -> gratis tanpa kartu kredit. Kunci: https://console.groq.com/keys
#   openrouter   -> model berakhiran :free. Kunci: https://openrouter.ai/keys
#   ollama       -> AI lokal (offline, tanpa kunci). https://ollama.com lalu: ollama pull llama3.2
#   openai       -> berbayar
AI_PROVIDER=pollinations
AI_API_KEY=
# AI_BASE_URL=   (opsional: alamat API kompatibel OpenAI lain)
# AI_MODEL=      (opsional: ganti model bawaan penyedia)
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=60000

# ---------- Keamanan akses dari browser ----------
# Halaman aplikasi yang boleh memakai AI (dipisah koma); WAJIB diisi agar editor di browser bisa memanggil server ini.
#   Pola port: http://localhost:*   |   file:// (uji lokal saja): null
#   Produksi: ALLOWED_ORIGINS=https://app1.kantor.go.id,https://app2.kantor.go.id
ALLOWED_ORIGINS=http://localhost:*
# Secret bersama dengan backend aplikasi untuk tiket akses AI (cookie HttpOnly "de_ai_ticket"), lihat README.
# Buat yang panjang & acak:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kosong = siapa pun dari origin terdaftar bisa memakai AI (hanya untuk uji lokal).
AI_AUTH_SECRET=
# AI_TICKET_COOKIE=de_ai_ticket
# Maksimum permintaan AI per pengguna (tiket) / IP per menit
AI_RATE_LIMIT=20

# ---------- Ekspor dari backend (server-ke-server) ----------
# Token rahasia yang dipakai BACKEND aplikasi Anda saat memanggil POST /api/export. Kosong = ekspor dimatikan.
EXPORT_TOKEN=
# CHROME_PATH=/usr/bin/chromium      (bila Chrome tidak ditemukan otomatis)
# CHROME_NO_SANDBOX=1                (perlu bila berjalan sebagai root, mis. di Docker)
# EXPORT_CONCURRENCY=2
# EXPORT_MAX_MB=30
# DOC_EDITOR_LIB=/path/ke/doc-editor.umd.js   (default ../dist/doc-editor.umd.js)
